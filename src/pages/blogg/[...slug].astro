---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const innlegg = await getCollection('blogg', ({ data }) => !data.utkast);
  return innlegg.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const datoFmt = (d: Date) => d.toLocaleDateString('nb-NO', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout tittel={post.data.tittel} beskrivelse={post.data.ingress}>
  <article class="prose">
    <a href="/blogg" class="text-sm muted">← Alle innlegg</a>
    <header style="margin-block: var(--space-md) var(--space-lg);">
      <time class="muted text-sm" datetime={post.data.dato.toISOString()}>{datoFmt(post.data.dato)}</time>
      <h1 style="margin-top: var(--space-2xs);">{post.data.tittel}</h1>
      <p class="muted" style="font-size: var(--text-lg);">{post.data.ingress}</p>
    </header>
    <Content />

    <aside class="retur-cta" aria-label="Om Intello">
      <p class="retur-cta__tekst">
        Jobber du med dette i praksis? <strong>Intello</strong> hjelper selskaper med arkitektur, sky og KI.
      </p>
      <a class="retur-cta__lenke" href="https://intello.no" rel="noopener">
        intello.no →
      </a>
    </aside>
  </article>
</BaseLayout>

<style>
  /* Lavmælt retur-CTA til søsken-merket Intello. Diskret, ikke påtrengende. */
  .retur-cta {
    margin-top: var(--space-2xl);
    padding: var(--space-md);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-primary);
    border-radius: var(--radius-md);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-md);
  }
  .retur-cta__tekst {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    max-width: 52ch;
  }
  .retur-cta__lenke {
    flex: none;
    color: var(--color-primary);
    font-weight: var(--weight-medium);
    font-size: var(--text-sm);
    text-decoration: none;
    white-space: nowrap;
  }
  .retur-cta__lenke:hover {
    color: var(--color-primary-strong);
    text-decoration: underline;
  }
</style>
