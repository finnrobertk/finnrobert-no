---
import { getCollection } from 'astro:content';
import { erPublisert } from '../lib/publisert';
import { pilarer, pilarNavn } from '../lib/pilarer';
import BaseLayout from '../layouts/BaseLayout.astro';

const innlegg = (await getCollection('blogg', ({ data }) => erPublisert(data)))
  .sort((a, b) => b.data.dato.valueOf() - a.data.dato.valueOf())
  .slice(0, 4);
const [hovedsak, ...flere] = innlegg;

const datoFmt = (d: Date) => d.toLocaleDateString('nb-NO', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout>
  <section class="hero">
    <h1 class="hero__title">KI og context engineering — forklart på norsk, <em>vist i praksis.</em></h1>
    <div class="hero__rad">
      <p class="hero__lead">
        Jeg heter Finn-Robert Kristensen — løsningsarkitekt og senior backendutvikler. Her deler jeg hvordan
        jeg faktisk jobber med KI og agenter. Ingen hype, ingen «10x»-løfter, bare praktiske oppsett og det jeg lærer underveis.
      </p>
      <p class="hero__handling">
        <a href="/blogg" class="btn">Les bloggen</a>
        <a href="/om">Mer om meg →</a>
      </p>
    </div>
  </section>

  {hovedsak && (
    <section aria-labelledby="siste">
      <div class="seksjonshode">
        <h2 id="siste">Siste innlegg</h2>
        <a href="/blogg">Alle innlegg →</a>
      </div>
      <div class="siste">
        <article class="hovedsak">
          {pilarNavn(hovedsak.data.pilar) && <span class="kicker kicker--aksent">{pilarNavn(hovedsak.data.pilar)}</span>}
          <h3 class="hovedsak__tittel"><a href={`/blogg/${hovedsak.id}`}>{hovedsak.data.tittel}</a></h3>
          <p class="hovedsak__ingress">{hovedsak.data.ingress}</p>
          <time class="muted text-sm" datetime={hovedsak.data.dato.toISOString()}>{datoFmt(hovedsak.data.dato)}</time>
        </article>
        {flere.length > 0 && (
          <ul class="flere">
            {flere.map((post) => (
              <li>
                {pilarNavn(post.data.pilar) && <span class="kicker">{pilarNavn(post.data.pilar)}</span>}
                <h3 class="flere__tittel"><a href={`/blogg/${post.id}`}>{post.data.tittel}</a></h3>
                <time class="muted text-sm" datetime={post.data.dato.toISOString()}>{datoFmt(post.data.dato)}</time>
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>
  )}

  <section aria-labelledby="spor" class="spor-seksjon">
    <div class="seksjonshode">
      <h2 id="spor">Hva jeg skriver om</h2>
    </div>
    <ol class="spor">
      {pilarer.map((p, i) => (
        <li>
          <span class="spor__nr" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3>{p.tittel}</h3>
          <p class="muted">{p.tekst}</p>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>

<style>
  .hero { padding-block: var(--space-xl) var(--space-2xl); }
  .hero__title {
    font-size: var(--text-display);
    font-weight: 360;
    line-height: 1;
    max-width: 13.5ch;
    margin: 0;
  }
  .hero__title em {
    font-weight: 340;
    color: var(--color-accent);
  }
  .hero__rad {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-lg);
    margin-top: var(--space-lg);
  }
  .hero__lead {
    margin: 0;
    max-width: 46ch;
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--color-text-muted);
  }
  .hero__handling {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md);
    margin: 0;
    font-weight: var(--weight-medium);
    font-size: var(--text-sm);
  }

  .siste {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr));
    gap: clamp(2rem, 5vw, 4.5rem);
  }
  .hovedsak {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }
  .hovedsak__tittel {
    margin: 0;
    font-size: clamp(2.125rem, 4vw, 3.25rem);
    font-weight: 420;
    line-height: 1.06;
    letter-spacing: -0.02em;
  }
  .hovedsak__ingress {
    margin: 0;
    max-width: 40ch;
    font-size: var(--text-lg);
    line-height: 1.6;
  }
  .hovedsak__tittel a,
  .flere__tittel a { color: var(--color-text); text-decoration: none; }
  .hovedsak__tittel a:hover,
  .flere__tittel a:hover { color: var(--color-primary); }

  .flere { list-style: none; margin: 0; padding: 0; }
  .flere li { padding-block: var(--space-md); border-bottom: 1px solid var(--color-border); }
  .flere li:first-child { padding-top: 0; }
  .flere li:last-child { border-bottom: none; }
  .flere__tittel {
    margin: var(--space-3xs) 0;
    font-size: 1.5625rem;
    font-weight: 480;
    line-height: 1.2;
  }

  .spor-seksjon { margin-top: clamp(4.5rem, 9vw, 8rem); }
  .spor {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: var(--space-lg) var(--space-xl);
  }
  .spor li { display: flex; flex-direction: column; gap: var(--space-2xs); }
  .spor__nr {
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: 300;
    font-size: 3.5rem;
    line-height: 1;
    color: var(--color-accent);
  }
  .spor h3 { margin: 0; font-size: var(--text-lg); font-weight: 520; line-height: 1.25; }
  .spor p { margin: 0; font-size: 1rem; line-height: 1.6; }
</style>
