---
import BaseLayout from '../layouts/BaseLayout.astro';

// MIDLERTIDIG: e-postadressen settes endelig når Fastmail for finnrobert.no er på plass
// (egen, utsatt oppgave). Bytt 'hei@finnrobert.no' når aliaset er opprettet.
const epost = 'hei@finnrobert.no';
const linkedin = 'https://www.linkedin.com/in/finnrobertk'; // TODO: bekreft riktig URL
---

<BaseLayout tittel="Kontakt" beskrivelse="Ta kontakt med Finn-Robert om KI, context engineering eller samarbeid.">
  <article class="prose">
    <h1>Kontakt</h1>
    <p style="font-size: var(--text-lg);">
      Har du et spørsmål om KI, en idé, eller lurer på om jeg kan hjelpe? Send meg en linje.
    </p>
    <ul>
      <li>E-post: <a href={`mailto:${epost}`}>{epost}</a></li>
      <li>LinkedIn: <a href={linkedin}>Finn-Robert Kristensen</a></li>
    </ul>
    <p class="muted text-sm">
      Jeg svarer som regel innen et par dager. For Intello-relaterte oppdrag, se
      <a href="https://intello.no">intello.no</a>.
    </p>
  </article>
</BaseLayout>
